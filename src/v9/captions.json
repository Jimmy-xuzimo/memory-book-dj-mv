    "endMs": 34666,
    "timestampMs": null,
    "confidence": null,
    "startFrame": 949,
    "endFrameExclusive": 1040
  },
  {
    "id": 13,
    "text": "我却已无法自拔",
    "startMs": 35000,
    "endMs": 38100,
    "timestampMs": null,
    "confidence": null,
    "startFrame": 1050,
    "endFrameExclusive": 1143
  },
  {
    "id": 14,
    "text": "我们的爱总有时差",
    "startMs": 38133,
    "endMs": 41100,
    "timestampMs": null,
    "confidence": null,
    "startFrame": 1144,
    "endFrameExclusive": 1233
  },
  {
